{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "mf",
  "sourceRoot": "apps/web/src",
  "tags": ["type:app", "scope:web"],
  "i18n": {
    "sourceLocale": { "code": "en", "subPath": "" },
    "locales": {
      "pl": { "translation": "apps/web/src/locale/messages.pl.xlf", "subPath": "pl" },
      "de": { "translation": "apps/web/src/locale/messages.de.xlf", "subPath": "de" },
      "es": { "translation": "apps/web/src/locale/messages.es.xlf", "subPath": "es" },
      "fr": { "translation": "apps/web/src/locale/messages.fr.xlf", "subPath": "fr" },
      "it": { "translation": "apps/web/src/locale/messages.it.xlf", "subPath": "it" },
      "pt-BR": { "translation": "apps/web/src/locale/messages.pt-BR.xlf", "subPath": "pt-br" },
      "cs": { "translation": "apps/web/src/locale/messages.cs.xlf", "subPath": "cs" },
      "uk": { "translation": "apps/web/src/locale/messages.uk.xlf", "subPath": "uk" }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/web",
        "browser": "apps/web/src/main.ts",
        "server": "apps/web/src/main.server.ts",
        "outputMode": "static",
        "polyfills": ["@angular/localize/init"],
        "tsConfig": "apps/web/tsconfig.app.json",
        "assets": [
          { "glob": "**/*", "input": "apps/web/public" },
          { "glob": "**/*", "input": "packages/ui/assets/fonts", "output": "assets/fonts" }
        ],
        "styles": [{ "input": "apps/web/src/styles.css", "bundleName": "style", "inject": false }]
      },
      "configurations": {
        "production": {
          "localize": true,
          "i18nMissingTranslation": "error",
          "budgets": [
            { "type": "initial", "maximumWarning": "320kb", "maximumError": "500kb" },
            { "type": "anyComponentStyle", "maximumWarning": "4kb", "maximumError": "8kb" }
          ],
          "optimization": {
            "scripts": true,
            "styles": { "minify": true, "inlineCritical": false },
            "fonts": true
          },
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": { "buildTarget": "web:build:production" },
        "development": { "buildTarget": "web:build:development" }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "web:build",
        "outputPath": "apps/web/src/locale"
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": { "watch": false }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "apps/web",
        "commands": ["ngc -p tsconfig.app.json --noEmit", "ngc -p tsconfig.spec.json --noEmit"],
        "parallel": false
      }
    }
  }
}
