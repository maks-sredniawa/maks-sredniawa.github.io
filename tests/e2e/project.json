{
  "name": "e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "tests/e2e/src",
  "tags": ["type:test"],
  "implicitDependencies": ["web"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "scripts/build.sh && scripts/e2e.sh"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "tsc -p tests/e2e/tsconfig.json --noEmit"
      }
    }
  }
}
